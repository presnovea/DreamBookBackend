<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Обрати внимание на %X{serviceType} и %X{pid} -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{serviceType}][PID:%X{pid}] [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>